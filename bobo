            <div class="category blue">All Day Menu</div>
            <div class="category green">Front Cabinet</div>
            <div class="category yellow">Alcohol</div>

        </div>

        <!-- PRODUCTS -->
        <div class="product-panel">

            <!-- QTY -->
            <div class="qty-bar">

                <div class="qty-title">QTY</div>

                <div class="qty-list">
                    <div class="qty-item active">1</div>
                    <div class="qty-item">2</div>
                    <div class="qty-item">3</div>
                    <div class="qty-item">4</div>
                    <div class="qty-item">5</div>
                    <div class="qty-item">6</div>
                    <div class="qty-item">7</div>
                    <div class="qty-item">8</div>
                    <div class="qty-item">9</div>
                    <div class="qty-item">10</div>
                </div>

            </div>

            <!-- ITEMS -->
            <div class="products">

                <div class="product gray">
                    <div class="product-name">Iced Long Black</div>
                    <div class="product-price">$6.50</div>
                </div>

                <div class="product gray">
                    <div class="product-name">Iced Latte</div>
                    <div class="product-price">$7.00</div>
                </div>

                <div class="product yellow">
                    <div class="product-name">Iced Cappuccino</div>
                    <div class="product-price">$8.50</div>
                </div>

                <div class="product blue">
                    <div class="product-name">Iced Chai Latte</div>
                    <div class="product-price">$8.00</div>
                </div>

                <div class="product blue">
                    <div class="product-name">Iced Mocha</div>
                    <div class="product-price">$8.00</div>
                </div>

                <div class="product purple">
                    <div class="product-name">Iced Coffee</div>
                    <div class="product-price">$8.00</div>
                </div>

                <div class="product green">
                    <div class="product-name">Iced Chocolate</div>
                    <div class="product-price">$8.00</div>
                </div>

                <div class="product orange">
                    <div class="product-name">Soft Drink</div>
                    <div class="product-price">$3.50</div>
                </div>

                <div class="product pink">
                    <div class="product-name">Energy Drink</div>
                    <div class="product-price">$5.00</div>
                </div>

                <div class="product green">
                    <div class="product-name">Water</div>
                    <div class="product-price">$4.00</div>
                </div>

                <div class="product green">
                    <div class="product-name">Sparkling Water</div>
                    <div class="product-price">$6.00</div>
                </div>

                <div class="product pink">
                    <div class="product-name">Iced Matcha</div>
                    <div class="product-price">$8.50</div>
                </div>

                <div class="product pink">
                    <div class="product-name">Pop Top</div>
                    <div class="product-price">$3.50</div>
                </div>

                <div class="product green">
                    <div class="product-name">Open Drink</div>
                    <div class="product-price">Variable</div>
                </div>

                <div class="product pink">
                    <div class="product-name">Iced Dirty Chai</div>
                    <div class="product-price">$8.00</div>
                </div>

                <div class="product yellow">
                    <div class="product-name">Iced Latte</div>
                    <div class="product-price">$7.00</div>
                </div>

                <div class="product pink">
                    <div class="product-name">Crush Drink</div>
                    <div class="product-price">$9.00</div>
                </div>

                <div class="product yellow">
                    <div class="product-name">Refreshing Drink</div>
                    <div class="product-price">$8.00</div>
                </div>

                <div class="product brown">
                    <div class="product-name">Espresso Sunrise</div>
                    <div class="product-price">$8.00</div>
                </div>

                <div class="product brown">
                    <div class="product-name">Iced Coconut Americano</div>
                    <div class="product-price">$8.00</div>
                </div>

            </div>

        </div>

    </div>

</div>

</body>
</html>
